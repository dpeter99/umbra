{
  "version": "1.0.0",
  "description": "My webpack project",
  "name": "my-webpack-project",
  "scripts": {
    "build": "deno run -A --unstable archivist.config.ts",
    "watch": "nodemon -w ./ -i \"template/dist/**/*\" -i \"out/**/*\" -e js,ts,tsx,jsx,scss,css -x \"npm run build\"",
    "serve": "web-dev-server --open --root-dir ./out/ --watch"
  }
}
