{
  "version": "1.0.0",
  "description": "My webpack project",
  "name": "my-webpack-project",
  "scripts": {
    "build:wp": "webpack --mode=production --node-env=production",
    "build:wp:dev": "webpack --mode=development",
    "build:wp:prod": "webpack --mode=production --node-env=production",
    "watch": "webpack --watch",
    "build": "sass --load-path=node_modules style/index.scss:dist/index.css && copyfiles -u 1 client/*.js dist"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "copyfiles": "^2.4.1",
    "postcss": "^8.4.20",
    "prettier": "^2.8.1",
    "sass": "^1.56.2"
  },
  "dependencies": {
    "@material/web": "0.1.0-alpha.0"
  }
}
